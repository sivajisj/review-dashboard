# Postgres connection string.
# If using the provided docker-compose.yml, this matches it out of the box.
DATABASE_URL=postgresql://review_user:review_pass@localhost:5432/review_dashboard

# Comma-separated list of product URLs to scrape reviews from.
# Defaults to the three AliveCor Amazon links from TASK.md if unset.
REVIEW_SOURCE_URLS=https://amzn.in/d/07vKnqI2,https://amzn.in/d/01qnlA6F,https://amzn.in/d/03eooMZA
